# Local development defaults. Never commit real keys or .env.local.
APP_ORIGIN=http://127.0.0.1:3100
DATA_BACKEND=local
# DATABASE_PATH=.local/ulterior.sqlite

# Production: preserve the existing project and use Supabase, not local SQLite.
# DATA_BACKEND=supabase
SUPABASE_URL=https://woyxnowfyhiedyplcspb.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# APP_ORIGIN=https://game.ulteriormotive.club
# APP_ORIGINS=https://ulteriormotive.club,https://www.ulteriormotive.club,https://game.ulteriormotive.club,https://automation.ulteriormotive.club

# Hosted AI: explicit model and valid key required. No scripted fallback in AI matches.
AI_MODE=practice
# AI_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# Example model when enabled for your provider account: gpt-4.1-mini
# Practice is scripted. Optional local-only Ollama mode remains supported:
# AI_MODE=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# Hostname routing is automatic for exact product domains; no enable flag is needed.
