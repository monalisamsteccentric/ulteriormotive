# Copy to .env.local only when overriding the working local defaults. Never commit actual secrets.
APP_ORIGIN=http://127.0.0.1:3100
# Future same-site multi-host setup: exact comma-separated trusted origins; never wildcard.
# APP_ORIGINS=https://ulteriormotive.club,https://game.ulteriormotive.club,https://automation.ulteriormotive.club
DATA_BACKEND=local
# Local SQLite works without external accounts; ignored .local directory.
# DATABASE_PATH=.local/ulterior.sqlite

# Set DATA_BACKEND=supabase only after applying supabase/migrations/001_initial.sql to your own project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# No provider keys are sent to the browser. Supabase mode uses Supabase Auth through the server.

# Local practice opponent is a clearly labelled scripted bot, not a language model.
# Optional Ollama-compatible model server; runs on your machine and requires an installed model.
AI_MODE=practice
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional later subdomain routing. No DNS or deployment is changed by this project.
ENABLE_SUBDOMAIN_ROUTING=false
